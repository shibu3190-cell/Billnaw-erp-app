{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "global.d.ts",
    "dom.js",
    "database.js",
    "inventory.js",
    "returns.js",
    "gstConfig.js",
    "exportEngine.js",
    "alertEngine.js",
    "printerEngine.js",
    "settings.js",
    "customers.js",
    "purchases.js",
    "supabaseClient.js",
    "app.js",
    "src/**/*.ts"
  ]
}
